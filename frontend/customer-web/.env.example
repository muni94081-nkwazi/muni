# Relative path, NOT an absolute http://localhost:8080 URL. The Vite dev
# server proxies `/api/*` to :8080 (see vite.config.ts `server.proxy`); an
# absolute URL here would bypass that proxy and hit :8080 directly (CORS,
# and it defeats the point of the proxy). Point this at your real API's
# origin only when serving a production build that isn't behind the same
# gateway/reverse-proxy as the frontend.
VITE_API_BASE_URL=/api/v1
# Chat-service is reached directly for Socket.io — the gateway proxy is HTTP-only.
VITE_CHAT_SERVICE_URL=http://localhost:4025
VITE_APP_NAME=MUNI
VITE_DEFAULT_CURRENCY=UGX

# Optional. Set to "true" in .env.local to develop the UI with no backend
# running at all — home page endpoints (categories/products/cart/containers)
# serve canned data from src/api/devMocks.ts instead of failing. Dev-only;
# has no effect in a production build. Leave unset/false when the real
# backend (or the mock backend on :8080) is up.
# VITE_USE_MOCK_API=true
