{
  "*.{ts,tsx}": [
    "eslint --fix --max-warnings=0",
    "prettier --write"
  ],
  "*.{js,mjs,cjs}": [
    "eslint --fix --max-warnings=0",
    "prettier --write"
  ],
  "*.{json,yml,yaml,md}": [
    "prettier --write"
  ],
  "*.{ts,tsx,js}": [
    "bash -c 'tsc --noEmit --skipLibCheck 2>&1 | head -20 || true'"
  ],
  "package*.json": [
    "npm audit --audit-level=high"
  ],
  "**/Dockerfile": [
    "hadolint --ignore DL3018 --ignore DL3008"
  ]
}
