# MUNI Platform — npm configuration
# ─────────────────────────────────────────────────────────────────────────────

# ── Security: Audit & Supply Chain ───────────────────────────────────────────
# Block installs with known vulnerabilities (high or critical)
audit-level=high

# Enforce exact package versions from package-lock.json
# This prevents unexpected dependency drift
save-exact=false

# Enforce that package-lock.json is up to date before installing
ci=false

# ── Registry ──────────────────────────────────────────────────────────────────
registry=https://registry.npmjs.org/

# ── Performance ───────────────────────────────────────────────────────────────
# Cache location for faster installs
# cache=~/.npm

# Prefer offline (use cached packages when available)
prefer-offline=false

# ── Workspace settings ────────────────────────────────────────────────────────
# Automatically install peer dependencies (npm 7+)
legacy-peer-deps=false

# ── Logging ──────────────────────────────────────────────────────────────────
loglevel=warn

# ── Package provenance (supply chain security) ────────────────────────────────
# Require package integrity checksums
strict-ssl=true

# ── Scripts ───────────────────────────────────────────────────────────────────
# Disable automatic lifecycle scripts on install (reduces supply-chain risk)
# Set to false if you need postinstall scripts (e.g. Prisma generate)
ignore-scripts=false

