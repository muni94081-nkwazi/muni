# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4033

# ── Configuration used by this service ───────────────────────────────────────

# ── Database ─────────────────────────────────────────────────────────────────
# pricing-service owns muni_pricing. Required: the service refuses to bind its port
# without it, because state it cannot durably record is state that silently
# disappears on the next restart.
DATABASE_URL=postgresql://muni:muni_secret@localhost:5432/muni_pricing
