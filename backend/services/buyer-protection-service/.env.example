# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4026

# ── Configuration used by this service ───────────────────────────────────────
ESCROW_AUTO_RELEASE_DAYS=
ESCROW_SWEEP_INTERVAL_MS=5000
PAYMENT_SERVICE_TIMEOUT_MS=5000
PAYMENT_SERVICE_URL=
USER_SERVICE_TIMEOUT_MS=5000
USER_SERVICE_URL=

# ── Database ─────────────────────────────────────────────────────────────────
# buyer-protection-service owns muni_buyer_protection. Required: the service refuses to bind its port
# without it, because state it cannot durably record is state that silently
# disappears on the next restart.
DATABASE_URL=postgresql://muni:muni_secret@localhost:5432/muni_buyer_protection
