PORT=4013
OPEN_EXCHANGE_RATES_APP_ID=
KAFKA_BROKERS=localhost:9092
BASE_CURRENCY=USD
RATE_REFRESH_INTERVAL_MS=21600000
LOG_LEVEL=info
NODE_ENV=development

# Shared rate cache. Without it each replica holds its own rates and the
# service logs "[rates-cache] REDIS_URL not set" on every start — it was the
# only service whose example omitted this.
REDIS_URL=redis://localhost:6379

# Live exchange rates. Without a real app id the service serves its built-in
# fallback rates and says so, loudly, rather than presenting stale figures as
# current. Left blank deliberately: this is an external credential.
OPEN_EXCHANGE_RATES_APP_ID=
