# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4025

# ── Configuration used by this service ───────────────────────────────────────
MONGO_URI=mongodb://muni:muni_secret@localhost:27017/muni_chat?authSource=admin

# Signs the token that unlocks an accepted offer's negotiated price at
# checkout — forging one lets a buyer set their own price, so treat it like a
# JWT signing key. Minimum 32 characters; the service refuses to start in
# production without it, and uses a random per-process value in development.
#   openssl rand -hex 32
OFFER_CHECKOUT_SECRET=
