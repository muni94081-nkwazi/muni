# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4016

# ── Configuration used by this service ───────────────────────────────────────
KAFKA_BROKERS=localhost:9092
LOG_LEVEL=

# ── Database ─────────────────────────────────────────────────────────────────
# wishlist-service owns muni_wishlist. Required: the service refuses to bind its port
# without it, because state it cannot durably record is state that silently
# disappears on the next restart.
DATABASE_URL=postgresql://muni:muni_secret@localhost:5432/muni_wishlist
