# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4032

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://muni:muni_secret@localhost:5432/muni_support?schema=public

# ── Kafka ────────────────────────────────────────────────────────────────────
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=support-service

# ── Upstream services ────────────────────────────────────────────────────────
USER_SERVICE_URL=http://localhost:3001
ORDER_SERVICE_URL=http://localhost:4003

# ── SLA targets (hours) ──────────────────────────────────────────────────────
# First response is tracked separately from resolution: it is the commitment
# that can be kept during a backlog, and the one requesters judge you on.
SLA_FIRST_RESPONSE_URGENT=1
SLA_FIRST_RESPONSE_HIGH=4
SLA_FIRST_RESPONSE_NORMAL=24
SLA_FIRST_RESPONSE_LOW=48
SLA_RESOLUTION_URGENT=8
SLA_RESOLUTION_HIGH=24
SLA_RESOLUTION_NORMAL=72
SLA_RESOLUTION_LOW=120
# How often breached tickets are flagged and resolved ones auto-closed.
SLA_SWEEP_INTERVAL_MS=300000
TICKET_AUTO_CLOSE_DAYS=7

# ── HTTP ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
