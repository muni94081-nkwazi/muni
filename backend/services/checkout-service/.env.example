PORT=4024
LOG_LEVEL=info
INVENTORY_SERVICE_URL=http://localhost:4011
ORDER_SERVICE_URL=http://localhost:4003
SHIPPING_SERVICE_URL=http://localhost:4005
TAX_SERVICE_URL=http://localhost:4014

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development

# ── Upstream services (checkout saga) ────────────────────────────────────────
# The saga calls each of these in order and compensates in reverse on failure,
# so an unreachable one fails the checkout rather than half-completing it.
CART_SERVICE_URL=http://localhost:4017
PRODUCT_SERVICE_URL=http://localhost:4002
PAYMENT_SERVICE_URL=http://localhost:4005
# Every cross-service call is bounded: an unbounded fetch inside a saga step
# holds an inventory reservation open until something else times out.
SERVICE_TIMEOUT_MS=5000

# ── Session & idempotency ────────────────────────────────────────────────────
# How long a started checkout survives before the buyer must begin again.
CHECKOUT_SESSION_TTL_SECONDS=1800
# Where replayed Idempotency-Key results are cached. Defaults to REDIS_URL.
IDEMPOTENCY_REDIS_URL=redis://localhost:6379
REDIS_URL=redis://localhost:6379
