# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4030

# ── Configuration used by this service ───────────────────────────────────────

# ── Database ─────────────────────────────────────────────────────────────────
# loyalty-service owns muni_loyalty. Required: the service refuses to bind its port
# without it, because state it cannot durably record is state that silently
# disappears on the next restart.
DATABASE_URL=postgresql://muni:muni_secret@localhost:5432/muni_loyalty
