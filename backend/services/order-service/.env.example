# ─── Order Service Environment Variables ──────────────────────────────────────
# Copy this file to .env and fill in the values before running the service.

# MongoDB connection string (Mongoose format)
# For local development with docker-compose:
MONGODB_URI="mongodb://localhost:27017/muni_orders"

# Service port
PORT=4003

# Node environment
NODE_ENV=development

# ─── Kafka ────────────────────────────────────────────────────────────────────
# Comma-separated list of broker addresses
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=order-service

# ─── RabbitMQ ─────────────────────────────────────────────────────────────────
RABBITMQ_URL=amqp://muni:muni_secret@localhost:5672
