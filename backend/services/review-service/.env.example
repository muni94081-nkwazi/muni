# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4011

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://muni:muni_secret@localhost:5432/muni_review?schema=public

# ── Kafka ────────────────────────────────────────────────────────────────────
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=review-service
KAFKA_GROUP_ID=review-service-order-group

# ── Upstream services ────────────────────────────────────────────────────────
# Used only when the local purchase projection has no record of a purchase.
ORDER_SERVICE_URL=http://localhost:4003
SERVICE_TIMEOUT_MS=5000

# ── Review policy ────────────────────────────────────────────────────────────
# Only buyers may review. Turning this off makes the star rating meaningless —
# intended for seed/demo environments only.
REVIEW_REQUIRE_VERIFIED_PURCHASE=true
# Require the item to have been delivered, not merely ordered.
REVIEW_REQUIRE_DELIVERY=true
# How long a buyer may correct their review after posting.
REVIEW_EDIT_WINDOW_HOURS=48
# PUBLISHED = post-moderation (reviews appear immediately); PENDING = pre-moderation.
REVIEW_DEFAULT_STATUS=PUBLISHED
# Independent reports needed before a published review is auto-pulled for review.
REVIEW_AUTO_HIDE_REPORTS=5
REVIEW_MAX_MEDIA=8

# ── HTTP ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
