# ─── newsletter-service ───────────────────────────────────────────────────────
#
# This service had no .env.example, so scripts/setup-dev.sh — which provisions
# every other component from one — had nothing to copy, and running it directly
# failed on "Missing required environment variable: DATABASE_URL". Under compose
# the container supplies the environment, which is why it went unnoticed.

PORT=4034
NODE_ENV=development

# The only value the service hard-requires (src/config/env.ts).
DATABASE_URL=postgresql://muni:muni_secret@localhost:5432/muni_newsletter

# Origins allowed to post a signup. Comma-separated; empty means none.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Signup rate limit per IP, to blunt list-bombing.
NEWSLETTER_RATE_WINDOW_MS=60000
NEWSLETTER_RATE_MAX=5

# Leave false: no email delivery is wired into this service, so single opt-in
# would strand every subscriber in PENDING with nothing to confirm against.
NEWSLETTER_SINGLE_OPT_IN=false
