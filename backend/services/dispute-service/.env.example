PORT=4021
LOG_LEVEL=info
SERVICE_NAME=dispute-service

# ── Database ─────────────────────────────────────────────────────────────────
# dispute-service owns muni_dispute. Required: the service refuses to bind its
# port without it, because a claim it cannot durably record is worse than a
# service that is plainly down — no escrow hold gets placed and nobody finds
# out until the money has been released.
DATABASE_URL=postgresql://muni:muni_secret@localhost:5432/muni_dispute

# ── Upstream services ────────────────────────────────────────────────────────
# Dispute outcomes feed the seller trust score (user-service) and release or
# hold escrow (buyer-protection-service).
USER_SERVICE_URL=http://localhost:3001
USER_SERVICE_TIMEOUT_MS=5000
BUYER_PROTECTION_SERVICE_URL=http://localhost:4026
BUYER_PROTECTION_SERVICE_TIMEOUT_MS=5000

# ── SLA ──────────────────────────────────────────────────────────────────────
# How often open disputes are swept for a breached response deadline.
DISPUTE_SLA_SWEEP_INTERVAL_MS=300000
