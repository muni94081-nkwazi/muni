# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4029

# ── Configuration used by this service ───────────────────────────────────────

# ── Database ─────────────────────────────────────────────────────────────────
# qa-service owns muni_qa. Required: the service refuses to bind its port
# without it, because state it cannot durably record is state that silently
# disappears on the next restart.
DATABASE_URL=postgresql://muni:muni_secret@localhost:5432/muni_qa
