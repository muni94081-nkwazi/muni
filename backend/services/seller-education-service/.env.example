# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4028

# ── Configuration used by this service ───────────────────────────────────────

# ── Database ─────────────────────────────────────────────────────────────────
# seller-education-service owns muni_seller_education. Required: the service refuses to bind its port
# without it, because state it cannot durably record is state that silently
# disappears on the next restart.
DATABASE_URL=postgresql://muni:muni_secret@localhost:5432/muni_seller_education
