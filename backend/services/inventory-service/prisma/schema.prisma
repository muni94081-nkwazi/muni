// ─── inventory-service Prisma schema ──────────────────────────────────────────
//
// ⚠ THIS SERVICE DOES NOT OWN THESE TABLES. product-service does.
//
// inventory-service reads and writes stock on product-service's database
// (same DATABASE_URL). This file exists only so `prisma generate` can produce
// a typed client for the three models it touches — it is NOT a migration
// source. There is deliberately no prisma/migrations directory here:
//
//   • Never run `prisma migrate dev`, `prisma migrate deploy` or `db push`
//     from this service. The models below are a deliberate subset — Product
//     alone omits a dozen real columns — so a push would drop them.
//   • Schema changes to Product / ProductVariant / InventoryReservation are
//     made in backend/services/product-service/prisma/schema.prisma, migrated
//     there, and then mirrored here.
//
// Why a local copy rather than importing product-service's generated client:
// every service in this monorepo generates into its own src/generated/prisma
// (see the note at the top of product-service's schema — a shared
// node_modules/@prisma/client gets overwritten by whichever service generated
// last). Reaching across into ../product-service/src/generated would also move
// the common source root tsc computes, changing every emitted dist path.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Subset: the fields inventory-service reads via `include: { product: … }`,
// plus status, which markProductOutOfStock() flips through raw SQL.
model Product {
  id       String        @id @default(cuid())
  name     String
  sellerId String
  status   ProductStatus @default(PENDING_APPROVAL)
  variants ProductVariant[]
}

enum ProductStatus {
  PENDING_APPROVAL
  ACTIVE
  REJECTED
  DRAFT
  ARCHIVED
  OUT_OF_STOCK
}

// Full scalar set, deliberately: GET /api/v1/inventory spreads the whole row
// into its response, so trimming columns here would silently change the API.
model ProductVariant {
  id                String    @id @default(cuid())
  productId         String
  product           Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku               String    @unique
  attributes        Json      @default("{}")
  price             Decimal   @db.Decimal(12, 2)
  compareAtPrice    Decimal?  @db.Decimal(12, 2)
  stock             Int       @default(0)
  reserved          Int       @default(0)
  lowStockThreshold Int       @default(5)
  weightKg          Float?
  length            Float?
  width             Float?
  height            Float?
  images            String[]  @default([])
  active            Boolean   @default(true)
  reservations      InventoryReservation[]
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([productId, active])
  @@index([active, stock])
}

// The only table inventory-service INSERTs into, via reserveInventory().
model InventoryReservation {
  id        String         @id @default(cuid())
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  userId    String?
  sessionId String
  quantity  Int
  expiresAt DateTime
  createdAt DateTime       @default(now())

  @@index([variantId])
  @@index([expiresAt])
  @@index([sessionId])
  @@index([sessionId, variantId])
}
