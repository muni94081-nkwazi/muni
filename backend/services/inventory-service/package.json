{
  "name": "@muni/inventory-service",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/services/inventory-service/src/index.js",
    "test": "node --experimental-vm-modules ../../../node_modules/jest/bin/jest.js --forceExit",
    "lint": "tsc --noEmit",
    "db:generate": "prisma generate",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@prisma/client": "^5.19.0",
    "amqplib": "^0.10.9",
    "bullmq": "^5.12.0",
    "cors": "^2.8.5",
    "date-fns": "^3.6.0",
    "express": "^4.21.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "kafkajs": "^2.2.4",
    "redis": "^4.7.1",
    "winston": "^3.14.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/amqplib": "^0.10.8",
    "@types/cors": "^2.8.17",
    "@types/express": "4.17.25",
    "@types/jest": "^29.5.13",
    "@types/node": "^22.7.4",
    "jest": "^29.7.0",
    "prisma": "^5.19.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.0",
    "typescript": "^5.6.2"
  },
  "prisma": {
    "//": "inventory-service has its own schema.prisma but deliberately NO migrations directory: it reads and writes product-service's tables on the shared database, and product-service owns their DDL. The schema exists purely so `prisma generate` can emit a typed client into src/generated/prisma. See the header comment in prisma/schema.prisma before changing it."
  }
}
