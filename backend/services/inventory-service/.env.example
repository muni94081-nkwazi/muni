NODE_ENV=development
PORT=4004

# Shared product DB (same as product-service)
DATABASE_URL=postgresql://muni:muni_secret@localhost:5432/muni_products?schema=public

# Redis for BullMQ expiry jobs
BULLMQ_REDIS_URL=redis://localhost:6379

# Redis for the RabbitMQ idempotent-consumer guard (event_processed:{eventId})
REDIS_URL=redis://localhost:6379

# Kafka
KAFKA_BROKERS=localhost:9092

# RabbitMQ
RABBITMQ_URL=amqp://muni:muni_secret@localhost:5672

# Inventory settings
LOW_STOCK_THRESHOLD=5
RESERVATION_TTL_MINUTES=15
EXPIRY_CHECK_INTERVAL_SECONDS=300
# Expired reservations released per transaction. Larger means fewer round trips
# but longer row locks. The first sweep after the worker has been disabled may
# face a large backlog, which is what this bounds.
EXPIRY_SWEEP_BATCH_SIZE=200

LOG_LEVEL=info
