PORT=4023
LOG_LEVEL=info

# ── Database ─────────────────────────────────────────────────────────────────
# fulfillment-service owns muni_fulfillment. Required: the service refuses to bind its port
# without it, because state it cannot durably record is state that silently
# disappears on the next restart.
DATABASE_URL=postgresql://muni:muni_secret@localhost:5432/muni_fulfillment
