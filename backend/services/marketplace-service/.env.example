PORT=4022
LOG_LEVEL=info

# ── Database ─────────────────────────────────────────────────────────────────
# marketplace-service owns muni_marketplace. Required: the service refuses to bind its port
# without it, because state it cannot durably record is state that silently
# disappears on the next restart.
DATABASE_URL=postgresql://muni:muni_secret@localhost:5432/muni_marketplace
