# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4007

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://muni:muni_secret@localhost:5432/muni_notification?schema=public

# ── Kafka ────────────────────────────────────────────────────────────────────
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=notification-service

# ── Upstream services ────────────────────────────────────────────────────────
# Resolves recipient phone/email and channel opt-ins. Without it, only in-app
# notifications can be written.
USER_SERVICE_URL=http://localhost:3001
SERVICE_TIMEOUT_MS=5000

# ── Delivery behaviour ───────────────────────────────────────────────────────
NOTIFICATION_MAX_ATTEMPTS=4
NOTIFICATION_RETRY_BASE_SECONDS=30
NOTIFICATION_RETRY_INTERVAL_MS=60000
NOTIFICATION_RETRY_BATCH=50
# Log messages instead of sending them. Use for local development so the whole
# pipeline runs without real credentials — never in production, where it would
# mean silently sending nothing.
NOTIFICATION_DRY_RUN=true

# Country used to normalise local phone numbers (07...) to E.164.
DEFAULT_COUNTRY=UG

# ── SMS: Africa's Talking (primary) ──────────────────────────────────────────
# Preferred SMS route for UG/ZM — local routes and sender IDs.
AT_ENABLED=false
AT_USERNAME=sandbox
AT_API_KEY=
# Leave blank to use the account default sender.
AT_SENDER_ID=
# Defaults to the sandbox host when AT_USERNAME=sandbox.
AT_BASE_URL=

# ── SMS fallback + WhatsApp: Twilio ──────────────────────────────────────────
TWILIO_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Must be a WhatsApp-enabled sender in "whatsapp:+123..." form.
TWILIO_WHATSAPP_FROM=

# ── Push: Firebase Cloud Messaging (HTTP v1) ─────────────────────────────────
# From the Firebase service-account JSON. Keep FCM_PRIVATE_KEY on one line with
# literal \n escapes; the service unescapes them.
FCM_ENABLED=false
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# ── Email: SMTP ──────────────────────────────────────────────────────────────
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=MUNI <no-reply@muni.example>

# ── HTTP ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# Override only when pointing at a Twilio regional edge or a test double.
TWILIO_BASE_URL=https://api.twilio.com
