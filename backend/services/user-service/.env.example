# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://muni:muni_secret@localhost:5432/muni_user?schema=public

# ── JWT ──────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=replace-me-with-a-32-byte-random-hex-string
JWT_REFRESH_SECRET=replace-me-with-a-different-32-byte-random-hex-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ── Password reset ───────────────────────────────────────────────────────────
PASSWORD_RESET_TOKEN_TTL_MINUTES=30

# ── Kafka ────────────────────────────────────────────────────────────────────
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=user-service

# ── HTTP ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# ── Address book ─────────────────────────────────────────────────────────────
MAX_ADDRESSES_PER_USER=20
