PORT=4020
LOG_LEVEL=info
SERVICE_NAME=return-service

# ── Database ─────────────────────────────────────────────────────────────────
# return-service owns muni_return. Required: the service refuses to bind its port
# without it, because state it cannot durably record is state that silently
# disappears on the next restart.
DATABASE_URL=postgresql://muni:muni_secret@localhost:5432/muni_return
