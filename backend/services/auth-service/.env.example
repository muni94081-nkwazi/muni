# ─── Auth Service Environment Variables ───────────────────────────────────────
# Copy this file to .env and fill in the values before running the service.

# PostgreSQL connection string (Prisma format)
# For local development with docker-compose:
DATABASE_URL="postgresql://muni:muni_secret@localhost:5432/muni_auth?schema=public"

# JWT secrets — use long random strings in production
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET="change-me-to-a-long-random-string-for-access-tokens"
JWT_REFRESH_SECRET="change-me-to-a-different-long-random-string-for-refresh-tokens"

# Token lifetimes
JWT_ACCESS_EXPIRES_IN="1h"
JWT_REFRESH_EXPIRES_IN="30d"

# Bcrypt cost factor (10 is fine for dev; use 12 in production)
BCRYPT_ROUNDS=10

# Service port
PORT=4001

# Node environment
NODE_ENV=development

# ─── Google OAuth2 ────────────────────────────────────────────────────────────
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must include: http://localhost:4001/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:4001/api/v1/auth/google/callback"

# Where to redirect the browser after successful OAuth login (your SPA)
FRONTEND_REDIRECT_URL="http://localhost:5174/auth/callback"

# ─── Facebook OAuth2 (same pattern as Google) ─────────────────────────────────
# Create an app at: https://developers.facebook.com/apps
# Valid OAuth Redirect URI must include: http://localhost:4001/api/v1/auth/facebook/callback
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""
FACEBOOK_CALLBACK_URL="http://localhost:4001/api/v1/auth/facebook/callback"

# ─── Apple ("Sign in with Apple") ─────────────────────────────────────────────
# Set up at: https://developer.apple.com/account/resources/identifiers/list/serviceId
# Requires: a Services ID (not your App ID), a Sign in with Apple key (.p8),
# its Key ID, and your Team ID. The Return URL configured in the Apple
# Developer portal must match APPLE_CALLBACK_URL exactly.
APPLE_CLIENT_ID=""
APPLE_TEAM_ID=""
APPLE_KEY_ID=""
# Paste the .p8 file contents with newlines escaped as \n, e.g.:
# APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIGTAgEAMBMGByqGSM49...\n-----END PRIVATE KEY-----"
APPLE_PRIVATE_KEY=""
APPLE_CALLBACK_URL="http://localhost:4001/api/v1/auth/apple/callback"

# ─── Document Storage ─────────────────────────────────────────────────────────
# DOCUMENT_STORE=local  → save to local filesystem (default, dev only)
# DOCUMENT_STORE=s3     → save to AWS S3 (requires AWS_ vars below)
DOCUMENT_STORE=local
UPLOAD_DIR=./uploads

# AWS S3 (only needed when DOCUMENT_STORE=s3)
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=muni-seller-documents
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""

# ─── Kafka ────────────────────────────────────────────────────────────────────
# Comma-separated list of broker addresses
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=auth-service

# ── Redis ────────────────────────────────────────────────────────────────────
# Session/token caching. Falls back to in-memory when unset, which is fine for
# a single instance but loses sessions on restart and cannot be shared.
REDIS_URL=redis://localhost:6379
