PORT=4019
LOG_LEVEL=info
SERVICE_NAME=fraud-service

# ── Database ─────────────────────────────────────────────────────────────────
# fraud-service owns muni_fraud. Required: the service refuses to bind its port
# without it, because state it cannot durably record is state that silently
# disappears on the next restart.
DATABASE_URL=postgresql://muni:muni_secret@localhost:5432/muni_fraud
