PORT=4010
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_PRODUCTS_INDEX=muni-products
KAFKA_BROKERS=localhost:9092
NODE_ENV=development
LOG_LEVEL=info

# Hybrid vector search
# provider: openai | huggingface | local (local = deterministic offline fallback, no API key needed)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
OPENAI_API_KEY=
HUGGINGFACE_API_KEY=
VECTOR_SEARCH_ENABLED=true
HYBRID_KNN_BOOST=1.5
HYBRID_BM25_BOOST=1
HYBRID_KNN_K=50
HYBRID_KNN_NUM_CANDIDATES=200
AUTOCOMPLETE_MAX_SUGGESTIONS=8
