PORT=4005
LOG_LEVEL=info

# ─── Kafka ──────────────────────────────────────────────────────────────────
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=payment-service

# ─── RabbitMQ ───────────────────────────────────────────────────────────────
RABBITMQ_URL=amqp://muni:muni_secret@localhost:5672

# ─── Redis (pending-payment polling worker + RabbitMQ idempotency guard) ───
REDIS_URL=redis://localhost:6379
PENDING_PAYMENT_POLL_INTERVAL_MS=5000
PENDING_PAYMENT_RETRY_BACKOFF_MS=5000
PENDING_PAYMENT_MAX_ATTEMPTS=24
PENDING_PAYMENT_BATCH_SIZE=50
PENDING_PAYMENT_LOCK_TTL_MS=10000

# ─── Currency Service (auto UGX conversion) ────────────────────────────────
CURRENCY_SERVICE_URL=http://localhost:4013
CURRENCY_CONVERT_TIMEOUT_MS=5000
DEFAULT_SETTLEMENT_CURRENCY=UGX

# ─── MTN Mobile Money Uganda (Collections + Disbursements) ────────────────
# Sandbox: https://sandbox.momodeveloper.mtn.com | Prod: set to your MTN proxy URL
MTN_MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_MOMO_TARGET_ENVIRONMENT=sandbox
MTN_MOMO_CURRENCY=UGX

# Collections product credentials
MTN_MOMO_COLLECTION_SUBSCRIPTION_KEY=
MTN_MOMO_COLLECTION_API_USER=
MTN_MOMO_COLLECTION_API_KEY=

# Disbursements product credentials
MTN_MOMO_DISBURSEMENT_SUBSCRIPTION_KEY=
MTN_MOMO_DISBURSEMENT_API_USER=
MTN_MOMO_DISBURSEMENT_API_KEY=

# Shared secret used to verify HMAC-SHA256 signature on inbound MTN webhooks
MTN_MOMO_WEBHOOK_HMAC_SECRET=change_me_mtn_webhook_secret

# ─── Airtel Money Uganda (C2B + B2C) ────────────────────────────────────────
# Sandbox: https://openapiuat.airtel.africa | Prod: https://openapi.airtel.africa
AIRTEL_MONEY_BASE_URL=https://openapiuat.airtel.africa
AIRTEL_MONEY_COUNTRY=UG
AIRTEL_MONEY_CURRENCY=UGX
AIRTEL_MONEY_CLIENT_ID=
AIRTEL_MONEY_CLIENT_SECRET=

# PEM-encoded RSA public key Airtel provides for encrypting the disbursement PIN
# (used with RSA-OAEP/SHA-256). Store the literal PEM with \n escaped, or point
# to a mounted secret file via AIRTEL_MONEY_PUBLIC_KEY_PATH instead.
AIRTEL_MONEY_PUBLIC_KEY=
AIRTEL_MONEY_PUBLIC_KEY_PATH=
AIRTEL_MONEY_DISBURSEMENT_PIN=

# Shared secret used to verify HMAC-SHA256 signature on inbound Airtel webhooks
AIRTEL_MONEY_WEBHOOK_HMAC_SECRET=change_me_airtel_webhook_secret

# ─── Legacy gateways (existing) ─────────────────────────────────────────────
# Left blank on purpose. These verify inbound settlement webhooks, and the
# values that used to sit here were real committed literals — copying this
# file to .env handed you a secret every reader of the repo already knew.
# An empty value makes verification reject every webhook for that gateway,
# which is the correct behaviour for an integration you have not configured.
FLUTTERWAVE_SECRET_HASH=
PESAPAL_CONSUMER_SECRET=

# ─── Visa/Mastercard Card Gateway (tokenized charges + 3DS2) ───────────────
# Sandbox base URL of the PCI-DSS Level 1 acquirer/gateway that holds card
# data. This service only ever receives the cardToken its client-side SDK
# produces — never a raw PAN/CVC.
VISA_CARD_GATEWAY_BASE_URL=https://sandbox.cardgateway.muni.ug/v2
VISA_CARD_MERCHANT_ID=
VISA_CARD_API_KEY=
VISA_CARD_API_SECRET=

# Webhook signature verification — set whichever scheme your gateway uses.
VISA_CARD_WEBHOOK_HMAC_SECRET=change_me_visa_webhook_secret
VISA_CARD_WEBHOOK_RSA_PUBLIC_KEY=

# Base URL of this service (for the 3DS ACS returnUrl) and of customer-web
# (where the browser is redirected once 3DS resolves).
VISA_CARD_3DS_RETURN_BASE_URL=http://localhost:4005
CUSTOMER_WEB_BASE_URL=http://localhost:5173

# ─── Database ─────────────────────────────────────────────────────────────────
# Postgres holds payment transactions, escrow holds, the vendor ledger and
# payouts. Unlike Redis/Kafka this is not optional: the service exits on a
# failed connection rather than accepting charges it cannot record.
DATABASE_URL=postgresql://muni:muni@localhost:5432/muni_payments?schema=public

# Local-only: lets GET /payments/:reference/status settle a pending non-mobile-money
# payment so checkout can be exercised without a provider sandbox. Never enable
# outside development.
PAYMENT_SIMULATE_SETTLEMENT=false

# ── Runtime ──────────────────────────────────────────────────────────────────
# `production` makes the mobile-money drivers refuse to start without real
# credentials rather than falling back to sandbox behaviour.
NODE_ENV=development
