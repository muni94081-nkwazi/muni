---
# Grafana v10 JSON — Kafka Metrics Dashboard
{
  "uid": "muni-kafka-metrics",
  "title": "MUNI — Kafka & Message Queue",
  "description": "Kafka broker health, topic throughput, consumer group lag, and DLQ monitoring",
  "tags": ["muni", "kafka", "messaging"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "topic",
        "type": "query",
        "label": "Topic",
        "query": "label_values(kafka_topic_partitions, topic)",
        "datasource": { "uid": "prometheus", "type": "prometheus" },
        "refresh": 2,
        "multi": true,
        "includeAll": true
      },
      {
        "name": "consumer_group",
        "type": "query",
        "label": "Consumer Group",
        "query": "label_values(kafka_consumergroup_lag, consumergroup)",
        "datasource": { "uid": "prometheus", "type": "prometheus" },
        "refresh": 2,
        "multi": true,
        "includeAll": true
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Consumer Group Lag (All Topics)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 8 },
      "datasource": { "uid": "prometheus", "type": "prometheus" },
      "targets": [
        {
          "expr": "sum(kafka_consumergroup_lag{consumergroup=~\"$consumer_group\", topic=~\"$topic\"}) by (consumergroup, topic)",
          "legendFormat": "{{consumergroup}} / {{topic}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1000 },
              { "color": "red", "value": 10000 }
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "title": "Messages Published / sec",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "datasource": { "uid": "prometheus", "type": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(kafka_messages_published_total[5m])) by (topic)",
          "legendFormat": "{{topic}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "mps" } }
    },
    {
      "id": 3,
      "title": "Messages Consumed / sec",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "datasource": { "uid": "prometheus", "type": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(kafka_messages_consumed_total[5m])) by (topic, consumer_group)",
          "legendFormat": "{{consumer_group}} ← {{topic}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "mps" } }
    },
    {
      "id": 4,
      "title": "Dead Letter Queue — Failed Messages",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 6 },
      "datasource": { "uid": "prometheus", "type": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(kafka_messages_failed_total[5m])) by (topic, consumer_group)",
          "legendFormat": "{{consumer_group}} / {{topic}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "mps",
          "color": { "fixedColor": "red", "mode": "fixed" }
        }
      }
    },
    {
      "id": 5,
      "title": "Under-Replicated Partitions",
      "type": "stat",
      "gridPos": { "x": 12, "y": 16, "w": 6, "h": 6 },
      "datasource": { "uid": "prometheus", "type": "prometheus" },
      "targets": [
        {
          "expr": "sum(kafka_topic_partition_under_replicated_partition)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "Healthy ✓", "color": "green" } } }
          ],
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "id": 6,
      "title": "Kafka Broker Count",
      "type": "stat",
      "gridPos": { "x": 18, "y": 16, "w": 6, "h": 6 },
      "datasource": { "uid": "prometheus", "type": "prometheus" },
      "targets": [
        {
          "expr": "count(kafka_brokers)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 2 },
              { "color": "green", "value": 3 }
            ]
          }
        }
      }
    }
  ]
}
