# ─── API Gateway Environment Variables ────────────────────────────────────────
# Copy this file to .env and fill in values before running the gateway.

# Service port
PORT=8080

# Upstream service URLs
AUTH_SERVICE_URL=http://localhost:4001
PRODUCT_SERVICE_URL=http://localhost:4002
ORDER_SERVICE_URL=http://localhost:4003
PAYMENT_SERVICE_URL=http://localhost:4005
SHIPPING_SERVICE_URL=http://localhost:4006
NOTIFICATION_SERVICE_URL=http://localhost:4007
RECOMMENDATION_SERVICE_URL=http://localhost:4008
ANALYTICS_SERVICE_URL=http://localhost:4009

# CORS — frontend origin
FRONTEND_ORIGIN=http://localhost:5174

# Redis — used for shared rate-limiting across gateway replicas
REDIS_URL=redis://localhost:6379

# Proxy timeout (ms) before returning 504
PROXY_TIMEOUT_MS=8000

# ─── Shared secrets ───────────────────────────────────────────────────────────
#
# These are NOT filled in here. scripts/setup-dev.sh generates them once into
# the root .env and copies the real values into this file, because every one of
# them has to be byte-identical across the gateway and every service that
# verifies what the gateway signs. A value invented here instead would start the
# gateway and then fail every signed call.
#
# INTERNAL_IDENTITY_SECRET is the one that stops the gateway from booting at all
# (see requireInternalIdentitySecret in gateway.ts). It signs the short-lived
# assertions order-, payment- and inventory-service verify; without a shared
# value those services fall back to trusting plain x-user-id headers.
#
# Generate manually with:  openssl rand -hex 32
INTERNAL_IDENTITY_SECRET=
JWT_REFRESH_SECRET=

# JWT secret (must match auth-service). Filled by scripts/setup-dev.sh from the
# root .env — a different value here means tokens minted by auth-service are
# rejected at the gateway.
JWT_ACCESS_SECRET=

NODE_ENV=development
