# Copy to .env and adjust. Only EXPO_PUBLIC_* vars are readable from app code —
# anything else is stripped from the bundle, so a variable that "does nothing"
# is usually missing that prefix.
#
# These are baked in at bundle time, not read at runtime: after changing this
# file restart Metro with `npx expo start -c` or the old value stays cached.

# ── API gateway base URL ──────────────────────────────────────────────────────
# Uncomment exactly ONE of the following for your setup.
#
# There is no single value that works everywhere, because "localhost" means a
# different machine in each case: on the Android emulator it is the emulator
# itself, on a physical device it is the phone.

# Android emulator (10.0.2.2 is the emulator's alias for the host machine):
EXPO_PUBLIC_API_URL=http://10.0.2.2:8080

# iOS simulator (shares the host's network stack, so localhost is the host):
# EXPO_PUBLIC_API_URL=http://localhost:8080

# Physical device — replace with your machine's LAN IP. The phone and the
# machine running docker must be on the same network, and the host firewall
# has to allow inbound 8080. Find the IP with:
#   Windows:  ipconfig          (IPv4 Address)
#   macOS:    ipconfig getifaddr en0
#   Linux:    hostname -I
# EXPO_PUBLIC_API_URL=http://192.168.1.X:8080

# Android 9+ and iOS block plain http by default. The dev builds in this repo
# already opt into cleartext for local addresses; a release build must use https.

# ── Everything else ───────────────────────────────────────────────────────────
EXPO_PUBLIC_ENV=development
EXPO_PUBLIC_POSTHOG_KEY=

# ── Error tracking ────────────────────────────────────────────────────────────
# Unset disables Sentry entirely — the normal state in development. A native
# crash leaves no server-side trace and gives the user no message to report, so
# this is the only way such a failure is ever seen.
EXPO_PUBLIC_SENTRY_DSN=
# 0-1. Traces are billed per event; 0.1 is the default when unset.
EXPO_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=
